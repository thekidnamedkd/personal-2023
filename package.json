    "@tanstack/react-query": "^5.90.20",
    "@types/lodash": "^4.17.23",
    "framer-motion": "^11.18.2",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
